<div class="max-w-md mx-auto w-full">
    <h1 class="text-3xl font-bold text-gray-900 mb-6">Create account</h1>
    <%= form_with model: @user, url: sign_up_path, scope: :user, class: "space-y-4" do |form| %>
        <% if @user.errors.any? %>
        <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-md">
            <ul class="list-disc list-inside">
                <% @user.errors.full_messages.each do |message| %>
                <li><%= message %></li>
                <% end %>
            </ul>
        </div>
        <% end %>
        <div>
            <%= form.label :email, class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= form.email_field :email, required: true, autocomplete: "email", class: "w-full px-3 py-2 border border-gray-300 rounded-md" %>
        </div>
        <div>
            <%= form.label :password, class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= form.password_field :password, required: true, minlength: 8, autocomplete: "new-password", class: "w-full px-3 py-2 border border-gray-300 rounded-md" %>
        </div>
        <div>
            <%= form.label :password_confirmation, class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", class: "w-full px-3 py-2 border border-gray-300 rounded-md" %>
        </div>
        <%= form.submit "Create account", class: "inline-flex justify-center py-2 px-4 rounded-md text-white bg-blue-600 hover:bg-blue-700" %>
    <% end %>
</div>
