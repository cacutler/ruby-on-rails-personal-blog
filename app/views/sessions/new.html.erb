<div class="max-w-md mx-auto w-full">
    <h1 class="text-3xl font-bold text-gray-900 mb-6">Sign in</h1>
    <%= form_with url: sign_in_path, scope: nil, class: "space-y-4" do |form| %>
        <div>
            <%= form.label :email, class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= form.email_field :email, required: true, autocomplete: "email", class: "w-full px-3 py-2 border border-gray-300 rounded-md" %>
        </div>
        <div>
            <%= form.label :password, class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= form.password_field :password, required: true, autocomplete: "current-password", class: "w-full px-3 py-2 border border-gray-300 rounded-md" %>
        </div>
        <%= form.submit "Sign in", class: "inline-flex justify-center py-2 px-4 rounded-md text-white bg-blue-600 hover:bg-blue-700" %>
    <% end %>
</div>
